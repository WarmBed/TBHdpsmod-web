---
import { Image } from 'astro:assets';
interface Props { src: ImageMetadata; alt: string; className?: string; priority?: boolean; }
const { src, alt, className, priority = false } = Astro.props;
---
<div class:list={['win', className]}>
  <Image src={src} alt={alt} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} />
</div>
