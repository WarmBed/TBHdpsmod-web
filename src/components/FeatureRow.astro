---
import type { Dict } from '../i18n/types';
import Screenshot from './Screenshot.astro';
interface Props { feature: Dict['features'][number]; image: ImageMetadata; image2?: ImageMetadata; reversed: boolean; }
const { feature, image, image2, reversed } = Astro.props;
---
<div class={`feat${reversed ? ' rev' : ''}`}>
  <div class="txt">
    <span class="tag">{feature.tag}</span>
    <h3>{feature.title}</h3>
    <p>{feature.body}</p>
    <ul>{feature.points.map((p) => <li>{p}</li>)}</ul>
  </div>
  <div>
    {image2 ? (
      <div class="shots">
        <Screenshot src={image} alt={feature.title} />
        <Screenshot src={image2} alt={feature.title} className="thumb" />
      </div>
    ) : (
      <Screenshot src={image} alt={feature.title} />
    )}
  </div>
</div>
