---
import { type Locale } from '../config';
interface Props { locale: Locale; }
const { locale } = Astro.props;

type T = Record<string, string>;
const STRINGS: Record<Locale, T> = {
  en: { search: 'Search watchlist…', name: 'Name', lastChg: 'Last / Chg', price: 'Price', chg: 'Chg', line: 'Line', candle: 'Candle', items: 'items', live: 'live', demo: 'demo', ago: 'ago', loading: 'Loading…', noMatch: 'No match', clickItem: 'Click a watchlist item →', open: 'Open', high: 'High', low: 'Low', median: 'Median', vol24: '24h vol', listings: 'Listings', orderBook: 'Order book', noOrderBook: 'No order book', noHistory: 'No price history', loadFail: 'Load failed', medianSale: 'median sale price', theme: 'Toggle theme' },
  'zh-Hant': { search: '搜尋物品…', name: '名稱', lastChg: '現價/漲跌', price: '現價', chg: '漲跌', line: '分時', candle: '日K', items: '個', live: '即時', demo: '範例', ago: '前', loading: '載入中…', noMatch: '無符合', clickItem: '點左側物品 →', open: '開', high: '高', low: '低', median: '中位', vol24: '24h量', listings: '在售', orderBook: '掛單簿', noOrderBook: '無掛單', noHistory: '無歷史', loadFail: '載入失敗', medianSale: '中位成交價', theme: '切換深淺色' },
  'zh-Hans': { search: '搜索物品…', name: '名称', lastChg: '现价/涨跌', price: '现价', chg: '涨跌', line: '分时', candle: '日K', items: '个', live: '实时', demo: '示例', ago: '前', loading: '加载中…', noMatch: '无匹配', clickItem: '点左侧物品 →', open: '开', high: '高', low: '低', median: '中位', vol24: '24h量', listings: '在售', orderBook: '挂单簿', noOrderBook: '无挂单', noHistory: '无历史', loadFail: '加载失败', medianSale: '中位成交价', theme: '切换深浅色' },
  ja: { search: 'アイテム検索…', name: '名前', lastChg: '価格/変動', price: '価格', chg: '変動', line: '時系列', candle: '日足', items: '件', live: 'リアル', demo: 'デモ', ago: '前', loading: '読み込み中…', noMatch: '該当なし', clickItem: '左のアイテムを選択 →', open: '始', high: '高', low: '安', median: '中央', vol24: '24h量', listings: '出品', orderBook: '板情報', noOrderBook: '板なし', noHistory: '履歴なし', loadFail: '読み込み失敗', medianSale: '中央販売価格', theme: 'テーマ切替' },
  es: { search: 'Buscar objetos…', name: 'Nombre', lastChg: 'Precio/Cambio', price: 'Precio', chg: 'Cambio', line: 'Línea', candle: 'Velas', items: 'objetos', live: 'vivo', demo: 'demo', ago: 'atrás', loading: 'Cargando…', noMatch: 'Sin resultados', clickItem: 'Selecciona un objeto →', open: 'Apert', high: 'Máx', low: 'Mín', median: 'Mediana', vol24: 'Vol 24h', listings: 'Ofertas', orderBook: 'Libro', noOrderBook: 'Sin libro', noHistory: 'Sin historial', loadFail: 'Error al cargar', medianSale: 'precio mediano', theme: 'Tema' },
};
const T = STRINGS[locale];
const RAW = 'https://raw.githubusercontent.com/WarmBed/TBH-DPS-dashboard/data';
---

<section class="term">
  <div class="term-top">
    <div class="term-brand">TBH <span class="ta">Terminal</span> <span class="tbadge">beta</span></div>
    <input id="t-search" type="text" placeholder={T.search} autocomplete="off" />
    <div class="term-tf" id="t-tf">
      <button data-tf="30">{T.line}</button>
      <button data-tf="60">1H</button>
      <button data-tf="120">2H</button>
      <button data-tf="240" class="on">4H</button>
      <button data-tf="480">8H</button>
      <button data-tf="1440">1D</button>
      <button data-tf="4320">3D</button>
    </div>
    <div class="term-tf" id="t-ind">
      <button data-ind="ma" class="on">MA</button>
      <button data-ind="boll" class="on">BOLL</button>
    </div>
    <div class="term-layouts">
      <button data-layout="4" class="on">2×2</button>
      <button data-layout="1">1</button>
    </div>
    <button id="t-theme" class="term-icon" title={T.theme} aria-label={T.theme}><svg viewBox="0 0 16 16" width="15" height="15"><circle cx="8" cy="8" r="6.2" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M8 1.8 A6.2 6.2 0 0 1 8 14.2 Z" fill="currentColor"/></svg></button>
    <span id="t-meta" class="term-meta"></span>
  </div>
  <div class="term-body">
    <aside class="term-watch">
      <div class="wl-head"><span class="wl-s" data-s="name">{T.name}</span><span><span class="wl-s" data-s="price">{T.price}</span>/<span class="wl-s" data-s="chg">{T.chg}</span>/<span class="wl-s" data-s="listings">{T.listings}</span></span></div>
      <div id="t-watch" class="wl-list"><div class="wl-loading">{T.loading}</div></div>
    </aside>
    <div id="t-grid" class="term-grid" data-layout="4"></div>
  </div>
</section>

<script is:inline define:vars={{ T, RAW, LOCALE: locale }}>
(function () {
  var UP = '#26d07c', DOWN = '#f0616d', UPF = 'rgba(38,208,124,.13)', DNF = 'rgba(240,97,109,.13)';
  var MA = [{ p: 5, c: '#e6e8ec' }, { p: 10, c: '#f5b942' }, { p: 30, c: '#c66bd6' }];
  var BOLLC = { mid: '#e6e8ec', band: '#3aa0e0' };
  var fix = null, panels = [null, null, null, null], active = 0, layout = '4', tf = 240, showMA = true, showBOLL = true, sortKey = 'vol', sortDir = -1;
  var $ = function (id) { return document.getElementById(id); };
  var termEl = document.querySelector('.term');
  function cvar(n) { return getComputedStyle(termEl).getPropertyValue(n).trim(); }

  function money(c) { return '$' + (c / 100).toFixed(2); }
  function big(n) { if (n >= 1e6) return (n / 1e6).toFixed(2) + 'M'; if (n >= 1e3) return (n / 1e3).toFixed(1) + 'K'; return '' + n; }

  function changePct(hist) {
    if (!hist || hist.length < 2) return null;
    var n = hist.length, last = hist[n - 1][1], span = hist[n - 1][0] - hist[0][0];
    if (span <= 0) return null;
    var step = span / (n - 1), back = Math.max(1, Math.round(86400 / step));
    var prev = hist[Math.max(0, n - 1 - back)][1];
    return prev ? (last - prev) / prev * 100 : null;
  }
  function pctClass(p) { return p === null ? '' : (p >= 0 ? 'up' : 'down'); }

  function toCandles(hist, target) {
    var n = hist.length, sz = Math.max(1, Math.ceil(n / target)), out = [];
    for (var i = 0; i < n; i += sz) {
      var seg = hist.slice(i, i + sz); if (!seg.length) continue;
      var o = seg[0][1], c = seg[seg.length - 1][1], hi = o, lo = o, v = 0;
      for (var j = 0; j < seg.length; j++) { var px = seg[j][1]; if (px > hi) hi = px; if (px < lo) lo = px; v += seg[j][2] || 0; }
      out.push({ t: seg[seg.length - 1][0], o: o, h: hi, l: lo, c: c, v: v });
    }
    return out;
  }
  // group points into fixed time buckets (periodSec) → real OHLC per period
  function bucketByPeriod(hist, periodSec) {
    var map = {}, order = [];
    for (var i = 0; i < hist.length; i++) {
      var p = hist[i], b = Math.floor(p[0] / periodSec);
      if (!map[b]) { map[b] = { t: p[0], o: p[1], h: p[1], l: p[1], c: p[1], v: 0 }; order.push(b); }
      var k = map[b]; if (p[1] > k.h) k.h = p[1]; if (p[1] < k.l) k.l = p[1]; k.c = p[1]; k.t = p[0]; k.v = p[2] || 0;   // 24h vol is a snapshot → take last in bucket
    }
    order.sort(function (a, b) { return a - b; });
    return order.map(function (b) { return map[b]; });
  }
  function sma(vals, p) {
    var out = new Array(vals.length).fill(null), s = 0;
    for (var i = 0; i < vals.length; i++) { s += vals[i]; if (i >= p) s -= vals[i - p]; if (i >= p - 1) out[i] = s / p; }
    return out;
  }
  function boll(closes, p, k) {
    var mid = sma(closes, p), up = new Array(closes.length).fill(null), lo = new Array(closes.length).fill(null);
    for (var i = p - 1; i < closes.length; i++) {
      var m = mid[i], sq = 0;
      for (var j = i - p + 1; j <= i; j++) sq += (closes[j] - m) * (closes[j] - m);
      var sd = Math.sqrt(sq / p); up[i] = m + k * sd; lo[i] = Math.max(0, m - k * sd);   // price can't be < 0
    }
    return { mid: mid, up: up, lo: lo };
  }
  function cleanVals(arr) {
    var s = arr.slice().sort(function (a, b) { return a - b; });
    var cap = s[Math.floor(s.length * 0.95)] || s[s.length - 1] || 1;
    return arr.map(function (x) { return Math.min(x, cap); });
  }

  function spark(vals, w, h) {
    if (!vals || vals.length < 2) return '';
    var v = cleanVals(vals), mn = Math.min.apply(null, v), mx = Math.max.apply(null, v), r = (mx - mn) || 1;
    var pts = v.map(function (val, i) { return ((i / (v.length - 1)) * (w - 2) + 1).toFixed(1) + ',' + (h - 1 - ((val - mn) / r) * (h - 2)).toFixed(1); });
    var up = vals[vals.length - 1] >= vals[0], col = up ? UP : DOWN;
    var area = 'M' + pts[0].split(',')[0] + ',' + h + ' L' + pts.join(' L') + ' L' + pts[pts.length - 1].split(',')[0] + ',' + h + ' Z';
    return '<svg width="' + w + '" height="' + h + '" viewBox="0 0 ' + w + ' ' + h + '"><path d="' + area + '" fill="' + (up ? UPF : DNF) + '"/><polyline points="' + pts.join(' ') + '" fill="none" stroke="' + col + '" stroke-width="1.2"/></svg>';
  }

  function dispName(it) { return (it.names && it.names[LOCALE]) || it.name; }
  function rarityOf(hash) { var m = /\(([^)]+)\)/.exec(hash); return m ? m[1] : ''; }
  function icon(it, size) { return it && it.icon ? '<img class="ic" loading="lazy" src="https://community.fastly.steamstatic.com/economy/image/' + it.icon + '/' + size + '" alt="">' : ''; }
  // Steam rarity colors are tuned for a dark bg; clamp luminance so names stay readable in either theme.
  function nameColor(hex) {
    hex = (hex || '888888'); if (hex.length === 3) hex = hex.replace(/./g, '$&$&');
    var r = parseInt(hex.slice(0, 2), 16), g = parseInt(hex.slice(2, 4), 16), b = parseInt(hex.slice(4, 6), 16);
    if (isNaN(r)) { r = g = b = 136; }
    var lum = 0.299 * r + 0.587 * g + 0.114 * b, light = termEl.getAttribute('data-theme') === 'light', f = 1;
    if (light && lum > 110) f = 110 / lum;            // too bright on white → darken
    else if (!light && lum < 95) f = 95 / Math.max(1, lum);   // too dark on near-black → lighten
    if (f !== 1) { r = Math.min(255, Math.round(r * f)); g = Math.min(255, Math.round(g * f)); b = Math.min(255, Math.round(b * f)); }
    return 'rgb(' + r + ',' + g + ',' + b + ')';
  }

  function renderWatch() {
    var q = ($('t-search').value || '').toLowerCase();
    var rows = fix.list.filter(function (it) { return it.name.toLowerCase().indexOf(q) >= 0 || dispName(it).toLowerCase().indexOf(q) >= 0; });
    rows.sort(function (a, b) {
      if (sortKey === 'name') return sortDir * a.name.localeCompare(b.name);
      var av, bv;
      if (sortKey === 'price') { av = a.price; bv = b.price; }
      else if (sortKey === 'chg') { av = (a.chg == null ? -1e9 : a.chg); bv = (b.chg == null ? -1e9 : b.chg); }
      else if (sortKey === 'listings') { av = a.listings; bv = b.listings; }
      else { av = a.vol; bv = b.vol; }
      return sortDir * (av - bv);
    });
    Array.prototype.forEach.call(document.querySelectorAll('.wl-s'), function (s) {
      var on = s.getAttribute('data-s') === sortKey; s.classList.toggle('act', on); s.classList.toggle('asc', on && sortDir > 0);
    });
    $('t-watch').innerHTML = rows.slice(0, 200).map(function (it) {
      var p = (it.chg != null ? it.chg : null), c = pctClass(p), sg = p >= 0 ? '+' : '';
      return '<div class="wl-row" data-hash="' + encodeURIComponent(it.hash) + '">' +
        '<div class="wl-ic">' + icon(it, '48fx48f') + '</div>' +
        '<div class="wl-l"><div class="wl-name" style="color:' + nameColor(it.color) + '">' + dispName(it) + '</div>' +
        '<div class="wl-tk">' + T.listings + ' ' + (it.listings || 0).toLocaleString() + '</div></div>' +
        '<div class="wl-spark">' + (it.spark ? spark(it.spark, 58, 22) : '') + '</div>' +
        '<div class="wl-r"><div class="wl-price num ' + c + '">' + money(it.price) + '</div>' +
        '<div class="wl-chip ' + c + '">' + (p === null ? '—' : sg + p.toFixed(2) + '%') + '</div></div>' +
        '</div>';
    }).join('') || '<div class="wl-loading">' + T.noMatch + '</div>';
    Array.prototype.forEach.call($('t-watch').querySelectorAll('.wl-row'), function (row) {
      row.addEventListener('click', function () { loadItem(decodeURIComponent(row.getAttribute('data-hash'))); });
    });
  }

  function loadItem(hash) { panels[active] = hash; renderGrid(); }   // load into the selected panel; click a panel to target it
  function paintActive() { Array.prototype.forEach.call($('t-grid').children, function (el, i) { el.classList.toggle('active', i === active); }); }

  function renderGrid() {
    var g = $('t-grid'); g.setAttribute('data-layout', layout);
    var count = layout === '1' ? 1 : 4, html = '';
    for (var i = 0; i < count; i++) html += '<div class="panel" data-i="' + i + '"></div>';
    g.innerHTML = html;
    Array.prototype.forEach.call(g.children, function (el, i) {
      el.addEventListener('click', function (e) { if (!e.target.closest('.p-close')) { active = i; paintActive(); } });
      renderPanel(el, panels[i], i);
    });
    paintActive();
  }

  function statsBar(it, hist) {
    var n = hist.length, last = hist[n - 1], cutoff = last[0] - 86400, w = hist.filter(function (x) { return x[0] >= cutoff; });
    if (w.length < 2) w = hist;
    var pr = w.map(function (x) { return x[1]; });
    function s(l, v, cls) { return '<span class="hs"><i>' + l + '</i><b class="' + (cls || '') + '">' + v + '</b></span>'; }
    return s(T.open, money(w[0][1])) + s(T.high, money(Math.max.apply(null, pr)), 'up') + s(T.low, money(Math.min.apply(null, pr)), 'down') +
      s(T.median, money(it.median)) + s(T.vol24, big(it.vol || 0)) + s(T.listings, it.listings.toLocaleString());
  }

  function renderPanel(el, hash, i) {
    if (!hash) { el.innerHTML = '<div class="p-empty">' + T.clickItem + '</div>'; return; }
    var it = fix.list.find(function (x) { return x.hash === hash; });
    var p = (it.chg != null ? it.chg : null), c = pctClass(p), sg = p >= 0 ? '+' : '', rar = rarityOf(hash);
    el.innerHTML =
      '<div class="p-head">' +
        '<div class="p-ic">' + icon(it, '62fx62f') + '</div>' +
        '<div class="p-id"><div class="p-l1"><span class="p-name" style="color:' + nameColor(it.color) + '">' + dispName(it) + '</span>' +
        (rar ? '<span class="p-rar">' + rar + '</span>' : '') + '</div>' +
        '<div class="p-quote"><span class="p-price num ' + c + '">' + money(it.price) + '</span>' +
        '<span class="p-chip ' + c + '">' + (p === null ? '' : sg + p.toFixed(2) + '%') + '</span></div></div>' +
        '<button class="p-close" title="clear">×</button>' +
      '</div>' +
      '<div class="p-statbar"></div>' +
      '<div class="p-body">' +
        '<div class="p-chartwrap"><div class="p-legend"></div><div class="p-chart"><div class="p-nochart">' + T.loading + '</div></div></div>' +
        '<div class="p-side"></div>' +
      '</div>';
    el.querySelector('.p-close').addEventListener('click', function () { panels[i] = null; renderGrid(); });
    getDetail(it).then(function (d) {
      if (!el.isConnected) return;
      el.querySelector('.p-side').innerHTML = orderbook(d);
      var chartBox = el.querySelector('.p-chart');
      if (d && d.hist && d.hist.length > 1) {
        el.querySelector('.p-statbar').innerHTML = statsBar(it, d.hist);
        chartBox.innerHTML = '<div class="p-tip" hidden></div>';
        drawChart(chartBox, el.querySelector('.p-legend'), d);
      } else { chartBox.innerHTML = '<div class="p-nochart">' + T.noHistory + '</div>'; }
    });
  }

  function orderbook(d) {
    if (!d || !d.orderbook || (!d.orderbook.sell.length && !d.orderbook.buy.length)) return '<div class="ob ob-empty">' + T.noOrderBook + '</div>';
    var ob = d.orderbook, sell = ob.sell.slice(0, 5).slice().reverse(), buy = ob.buy.slice(0, 5);
    var maxq = Math.max(1, Math.max.apply(null, ob.sell.concat(ob.buy).map(function (x) { return x.qty; })));
    function row(o, side) {
      return '<div class="ob-row ' + side + '"><span class="ob-bar" style="width:' + (o.qty / maxq * 100).toFixed(0) + '%"></span>' +
        '<span class="ob-p num">' + money(o.price) + '</span><span class="ob-q num">' + o.qty.toLocaleString() + '</span></div>';
    }
    return '<div class="ob"><div class="ob-h">' + T.orderBook + '</div>' +
      sell.map(function (o) { return row(o, 'ask'); }).join('') +
      '<div class="ob-mid num">' + money(ob.lowSell) + ' / ' + money(ob.highBuy) + '</div>' +
      buy.map(function (o) { return row(o, 'bid'); }).join('') + '</div>';
  }

  function drawChart(box, legend, d) {
    var W = box.clientWidth || 520, H = box.clientHeight || 300;
    var hasVol = d.hist.some(function (x) { return x[2] > 0; });
    var padR = 50, padB = 16, volH = hasVol ? Math.round(H * 0.22) : 0, gap = hasVol ? 8 : 0, priceH = H - volH - padB - gap;
    var iw = W - padR;
    var ma5 = cvar('--ma5') || '#888';
    var mas = MA.map(function (m, i) { return { c: i === 0 ? ma5 : m.c, p: m.p }; });
    var cp = cleanVals(d.hist.map(function (x) { return x[1]; }));
    cp[cp.length - 1] = d.hist[d.hist.length - 1][1];   // never clamp the current price — chart must end at the header
    var chist = d.hist.map(function (x, i) { return [x[0], cp[i], x[2]]; });
    var cnd = bucketByPeriod(chist, tf * 60);
    // fine periods (≤2h) are too sparse for candles right now → draw a line of the period closes
    if (tf <= 120) return drawLine(box, legend, { hist: cnd.map(function (k) { return [k.t, k.c, k.v]; }) }, W, H, iw, priceH, volH, padB, gap);
    var n = cnd.length, closes = cnd.map(function (k) { return k.c; });
    mas.forEach(function (m) { m.v = sma(closes, m.p); });
    var bb = boll(closes, 20, 2);
    var pmn = Math.min.apply(null, cnd.map(function (k) { return k.l; })), pmx = Math.max.apply(null, cnd.map(function (k) { return k.h; }));
    [bb.up, bb.lo].forEach(function (a) { a.forEach(function (x) { if (x != null) { if (x > pmx) pmx = x; if (x < pmn) pmn = x; } }); });
    var pr = (pmx - pmn) || 1;
    var cw = iw / n, bw = Math.max(1, cw * 0.62);
    function X(i) { return i * cw + cw / 2; }
    function PY(v) { return 4 + priceH - ((v - pmn) / pr) * priceH; }
    var vmx = Math.max.apply(null, cnd.map(function (k) { return k.v; })) || 1, vy0 = H - padB;
    function VY(v) { return vy0 - (v / vmx) * volH; }

    var grid = '', axis = '';
    [0, 0.25, 0.5, 0.75, 1].forEach(function (f) {
      var val = pmn + f * pr, y = PY(val);
      grid += '<line x1="0" y1="' + y.toFixed(1) + '" x2="' + iw + '" y2="' + y.toFixed(1) + '" class="g"/>';
      axis += '<text x="' + (W - padR + 4) + '" y="' + (y + 3).toFixed(1) + '" class="ax">' + money(val) + '</text>';
    });
    var sticks = '';
    for (var i = 0; i < n; i++) {
      var k = cnd[i], up = k.c >= k.o, col = up ? UP : DOWN, x = X(i);
      var yb = PY(up ? k.c : k.o), bh = Math.max(0.8, Math.abs(PY(k.o) - PY(k.c)));
      sticks += '<line x1="' + x.toFixed(1) + '" y1="' + PY(k.h).toFixed(1) + '" x2="' + x.toFixed(1) + '" y2="' + PY(k.l).toFixed(1) + '" stroke="' + col + '" stroke-width="1"/>' +
        '<rect x="' + (x - bw / 2).toFixed(1) + '" y="' + yb.toFixed(1) + '" width="' + bw.toFixed(1) + '" height="' + bh.toFixed(1) + '" fill="' + col + '"/>';
    }
    function poly(arr, col, w, dash) {
      var pts = '';
      for (var i = 0; i < arr.length; i++) if (arr[i] != null) pts += X(i).toFixed(1) + ',' + PY(arr[i]).toFixed(1) + ' ';
      return pts ? '<polyline points="' + pts.trim() + '" fill="none" stroke="' + col + '" stroke-width="' + (w || 1) + '"' + (dash ? ' stroke-dasharray="3 3"' : '') + ' opacity="0.9"/>' : '';
    }
    var ind = '';
    if (showBOLL) ind += poly(bb.up, BOLLC.band, 1) + poly(bb.lo, BOLLC.band, 1) + poly(bb.mid, ma5, 1, true);
    if (showMA) mas.forEach(function (m) { ind += poly(m.v, m.c, 1.2); });
    var vol = '';
    if (hasVol) {
      for (var j = 0; j < n; j++) { var kk = cnd[j], upj = kk.c >= kk.o; vol += '<rect x="' + (X(j) - bw / 2).toFixed(1) + '" y="' + VY(kk.v).toFixed(1) + '" width="' + bw.toFixed(1) + '" height="' + (vy0 - VY(kk.v)).toFixed(1) + '" fill="' + (upj ? UP : DOWN) + '" opacity="0.5"/>'; }
      var vols = cnd.map(function (k) { return k.v; }), mav5 = sma(vols, 5), mav10 = sma(vols, 10);
      function vpoly(arr, col) { var pts = ''; for (var i = 0; i < arr.length; i++) if (arr[i] != null) pts += X(i).toFixed(1) + ',' + VY(arr[i]).toFixed(1) + ' '; return pts ? '<polyline points="' + pts.trim() + '" fill="none" stroke="' + col + '" stroke-width="1"/>' : ''; }
      vol += vpoly(mav5, '#f5b942') + vpoly(mav10, '#c66bd6');
    }

    var dt0 = new Date(cnd[0].t * 1000), dt1 = new Date(cnd[n - 1].t * 1000);
    function md(x) { return (x.getMonth() + 1) + '/' + x.getDate(); }
    axis += '<text x="0" y="' + (H - 4) + '" class="ax">' + md(dt0) + '</text><text x="' + (iw - 4) + '" y="' + (H - 4) + '" class="ax" text-anchor="end">' + md(dt1) + '</text>';

    box.insertAdjacentHTML('afterbegin', '<svg class="p-svg" width="' + W + '" height="' + H + '" viewBox="0 0 ' + W + ' ' + H + '">' +
      grid + ind + sticks +
      (hasVol ? '<line x1="0" y1="' + vy0 + '" x2="' + iw + '" y2="' + vy0 + '" class="g"/>' : '') + vol +
      '<line class="cx" x1="0" y1="4" x2="0" y2="' + (4 + priceH) + '" opacity="0"/><line class="cxv" x1="0" y1="' + (vy0 - volH) + '" x2="0" y2="' + vy0 + '" opacity="0"/>' +
      axis + '</svg>');

    function legendFor(idx) {
      var k = cnd[idx];
      var h = '<span class="lg-d">' + md(new Date(k.t * 1000)) + '</span>' +
        '<span>O<b>' + money(k.o) + '</b></span><span>H<b class="up">' + money(k.h) + '</b></span><span>L<b class="down">' + money(k.l) + '</b></span><span>C<b>' + money(k.c) + '</b></span>' +
        (hasVol ? '<span>V<b>' + big(k.v) + '</b></span>' : '');
      h += '<span class="lg-sep"></span>';
      if (showMA) mas.forEach(function (m) { h += '<span style="color:' + m.c + '">MA' + m.p + ' ' + (m.v[idx] != null ? money(m.v[idx]) : '—') + '</span>'; });
      if (showBOLL) h += '<span style="color:' + BOLLC.band + '">BOLL ' + (bb.mid[idx] != null ? money(bb.mid[idx]) : '—') + '</span>';
      legend.innerHTML = h;
    }
    legendFor(n - 1);

    var svgEl = box.querySelector('.p-svg'), cx = box.querySelector('.cx'), cxv = box.querySelector('.cxv'), tip = box.querySelector('.p-tip');
    box.addEventListener('mousemove', function (e) {
      var rect = svgEl.getBoundingClientRect(), x = e.clientX - rect.left;
      if (x < 0 || x > iw) return;
      var idx = Math.max(0, Math.min(n - 1, Math.floor(x / cw))), px = X(idx);
      cx.setAttribute('x1', px); cx.setAttribute('x2', px); cx.setAttribute('opacity', '1');
      cxv.setAttribute('x1', px); cxv.setAttribute('x2', px); cxv.setAttribute('opacity', '1');
      legendFor(idx);
      var k = cnd[idx];
      var kd = new Date(k.t * 1000);
      tip.innerHTML = '<b class="' + (k.c >= k.o ? 'up' : 'down') + '">' + money(k.c) + '</b><span>H ' + money(k.h) + ' · L ' + money(k.l) + '</span>' + (k.v > 0 ? '<span>vol ' + k.v.toLocaleString() + '</span>' : '') + '<span>' + (kd.getMonth() + 1) + '/' + kd.getDate() + ' ' + kd.getHours() + ':00</span>';
      tip.hidden = false; tip.style.left = Math.min(iw - 110, Math.max(0, px + 6)) + 'px';
    });
    box.addEventListener('mouseleave', function () { cx.setAttribute('opacity', '0'); cxv.setAttribute('opacity', '0'); tip.hidden = true; legendFor(n - 1); });
  }

  function drawLine(box, legend, d, W, H, iw, priceH, volH, padB, gap) {
    var hist = d.hist, n = hist.length;
    var pv = cleanVals(hist.map(function (x) { return x[1]; }));
    pv[pv.length - 1] = hist[hist.length - 1][1];   // keep the chart ending at the current price
    var pmn = Math.min.apply(null, pv), pmx = Math.max.apply(null, pv), pr = (pmx - pmn) || 1;
    var vols = hist.map(function (x) { return x[2] || 0; }), vmx = Math.max(1, Math.max.apply(null, vols)), vy0 = H - padB, padR = W - iw, hasVol = volH > 0;
    function X(i) { return (i / (n - 1)) * iw; }
    function PY(v) { return 4 + priceH - ((v - pmn) / pr) * priceH; }
    var line = '', i;
    for (i = 0; i < n; i++) line += (i ? 'L' : 'M') + X(i).toFixed(1) + ' ' + PY(pv[i]).toFixed(1) + ' ';
    var up = hist[n - 1][1] >= hist[0][1], col = up ? UP : DOWN;
    var area = line + 'L' + iw + ' ' + (4 + priceH) + ' L0 ' + (4 + priceH) + ' Z';
    var grid = '', axis = '';
    [0, 0.5, 1].forEach(function (f) { var val = pmn + f * pr, y = PY(val); grid += '<line x1="0" y1="' + y.toFixed(1) + '" x2="' + iw + '" y2="' + y.toFixed(1) + '" class="g"/>'; axis += '<text x="' + (W - padR + 4) + '" y="' + (y + 3).toFixed(1) + '" class="ax">' + money(val) + '</text>'; });
    var vol = '';
    if (hasVol) for (i = 0; i < n; i++) { var bh = (vols[i] / vmx) * volH, bw = Math.max(0.6, iw / n - 0.4); vol += '<rect x="' + X(i).toFixed(1) + '" y="' + (vy0 - bh).toFixed(1) + '" width="' + bw.toFixed(1) + '" height="' + bh.toFixed(1) + '" fill="' + col + '" opacity="0.35"/>'; }
    box.insertAdjacentHTML('afterbegin', '<svg class="p-svg" width="' + W + '" height="' + H + '" viewBox="0 0 ' + W + ' ' + H + '">' + grid +
      (hasVol ? '<line x1="0" y1="' + vy0 + '" x2="' + iw + '" y2="' + vy0 + '" class="g"/>' : '') + vol +
      '<path d="' + area + '" fill="' + (up ? UPF : DNF) + '"/><path d="' + line + '" fill="none" stroke="' + col + '" stroke-width="1.5"/>' +
      '<line class="cx" x1="0" y1="4" x2="0" y2="' + (4 + priceH) + '" opacity="0"/>' + axis + '</svg>');
    var svgEl = box.querySelector('.p-svg'), cx = box.querySelector('.cx'), tip = box.querySelector('.p-tip');
    function md(t) { var dt = new Date(t * 1000); return (dt.getMonth() + 1) + '/' + dt.getDate() + ' ' + dt.getHours() + ':00'; }
    function lg(idx) { legend.innerHTML = '<span class="lg-d">' + md(hist[idx][0]) + '</span><span><b>' + money(pv[idx]) + '</b></span>' + (hist[idx][2] > 0 ? '<span>vol<b>' + big(hist[idx][2]) + '</b></span>' : ''); }
    lg(n - 1);
    box.addEventListener('mousemove', function (e) {
      var rect = svgEl.getBoundingClientRect(), x = e.clientX - rect.left;
      if (x < 0 || x > iw) return;
      var idx = Math.max(0, Math.min(n - 1, Math.round(x / iw * (n - 1)))), px = X(idx);
      cx.setAttribute('x1', px); cx.setAttribute('x2', px); cx.setAttribute('opacity', '1');
      lg(idx);
      tip.innerHTML = '<b>' + money(pv[idx]) + '</b><span>' + md(hist[idx][0]) + '</span>' + (hist[idx][2] > 0 ? '<span>vol ' + hist[idx][2].toLocaleString() + '</span>' : '');
      tip.hidden = false; tip.style.left = Math.min(iw - 110, Math.max(0, px + 6)) + 'px';
    });
    box.addEventListener('mouseleave', function () { cx.setAttribute('opacity', '0'); tip.hidden = true; lg(n - 1); });
  }

  // theme
  function setTheme(t) { termEl.setAttribute('data-theme', t); try { localStorage.setItem('tbh-term-theme', t); } catch (e) {} }
  $('t-theme').addEventListener('click', function () {
    setTheme(termEl.getAttribute('data-theme') === 'light' ? 'dark' : 'light');
    if (fix) { renderWatch(); renderGrid(); }   // re-run so theme-aware name colors update
  });
  (function () {
    var saved; try { saved = localStorage.getItem('tbh-term-theme'); } catch (e) {}
    setTheme(saved || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark'));
  })();

  $('t-search').addEventListener('input', renderWatch);
  Array.prototype.forEach.call(document.querySelectorAll('.wl-s'), function (s) {
    s.addEventListener('click', function () {
      var k = s.getAttribute('data-s');
      if (sortKey === k) sortDir = -sortDir; else { sortKey = k; sortDir = (k === 'name' ? 1 : -1); }
      if (fix) renderWatch();
    });
  });
  Array.prototype.forEach.call(document.querySelectorAll('#t-tf button'), function (b) {
    b.addEventListener('click', function () { document.querySelectorAll('#t-tf button').forEach(function (x) { x.classList.remove('on'); }); b.classList.add('on'); tf = parseInt(b.getAttribute('data-tf'), 10); renderGrid(); });
  });
  Array.prototype.forEach.call(document.querySelectorAll('#t-ind button'), function (b) {
    b.addEventListener('click', function () { var k = b.getAttribute('data-ind'); if (k === 'ma') showMA = !showMA; else showBOLL = !showBOLL; b.classList.toggle('on'); renderGrid(); });
  });
  Array.prototype.forEach.call(document.querySelectorAll('.term-layouts button'), function (b) {
    b.addEventListener('click', function () { document.querySelectorAll('.term-layouts button').forEach(function (x) { x.classList.remove('on'); }); b.classList.add('on'); layout = b.getAttribute('data-layout'); if (layout === '1') active = 0; renderGrid(); });
  });
  var rt; window.addEventListener('resize', function () { clearTimeout(rt); rt = setTimeout(renderGrid, 150); });

  var LIVE = false, detailCache = {};
  function conv(d) { return d; }   // data is already USD cents (from our Steam prices.json)
  function getDetail(it) {
    var h = it.hash;
    if (detailCache[h] !== undefined) return Promise.resolve(detailCache[h]);
    if (!LIVE) { detailCache[h] = conv((fix.detail && fix.detail[h]) || null); return Promise.resolve(detailCache[h]); }
    // tie the detail cache key to the loaded market snapshot so the chart never lags the header
    return fetch(RAW + '/detail/' + it.slug + '.json?v=' + ((fix && fix.builtAt) || '')).then(function (r) { if (!r.ok) throw 0; return r.json(); })
      .then(function (d) { detailCache[h] = conv(d); return detailCache[h]; }).catch(function () { detailCache[h] = null; return null; });
  }

  function start(data, live) {
    fix = data; LIVE = live;
    if (!live) {
      fix.list.forEach(function (it) { var d = fix.detail && fix.detail[it.hash]; if (d && d.hist && d.hist.length > 1) { it.chg = changePct(d.hist); it.spark = d.hist.map(function (p) { return p[1]; }); } });
    }
    var ageH = Math.round((Date.now() - data.builtAt) / 3600000);
    $('t-meta').textContent = (live ? T.live : T.demo) + ' · ' + data.total + ' ' + T.items + ' · ' + ageH + 'h ' + T.ago;
    renderWatch();
    var top = data.list.slice().sort(function (a, b) { return b.vol - a.vol; });
    for (var i = 0; i < 4; i++) panels[i] = top[i] ? top[i].hash : null;
    active = 0; renderGrid();
  }

  fetch(RAW + '/market.json').then(function (r) { if (!r.ok) throw 0; return r.json(); })
    .then(function (d) { start(d, true); })
    .catch(function () {
      fetch('/market/fixture.json').then(function (r) { return r.json(); }).then(function (d) { start(d, false); })
        .catch(function (e) { $('t-watch').innerHTML = '<div class="wl-loading">' + T.loadFail + ': ' + e.message + '</div>'; });
    });
})();
</script>

<style is:global>
.term{
