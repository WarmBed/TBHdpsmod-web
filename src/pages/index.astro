---
import BaseLayout from '../components/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import StatsBand from '../components/StatsBand.astro';
import FeatureRow from '../components/FeatureRow.astro';
import InstallSteps from '../components/InstallSteps.astro';
import MarketSection from '../components/MarketSection.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import { getDict } from '../i18n';
import hub from '../assets/hub.png';
import dps from '../assets/dps.png';
import taken from '../assets/taken.png';
import compare from '../assets/compare.png';
import gearscore from '../assets/gearscore.png';
import itemstats from '../assets/itemstats.png';
import farm from '../assets/farm.png';
import box from '../assets/box.png';
import boxopen from '../assets/boxopen.png';
import heatmap from '../assets/heatmap.png';
import priceBag from '../assets/price-bag.png';
import priceCurve from '../assets/price.png';
const locale = 'en' as const;
const dict = getDict(locale);
const images = [hub, dps, taken, compare, gearscore, itemstats, farm, box, boxopen, heatmap, priceBag];
const images2: (ImageMetadata | undefined)[] = [];
images2[images.length - 1] = priceCurve;   // price card shows the backpack shot + a curve thumbnail
---
<BaseLayout locale={locale} path="/" title={dict.meta.homeTitle} description={dict.meta.homeDesc} jsonLd>
  <Hero locale={locale} />
  <StatsBand locale={locale} />
  <section class="section alt" id="features"><div class="wrap">
    <div class="kicker">{dict.featuresKicker}</div>
    <h2 class="h2">{dict.featuresTitle}</h2>
    <p class="sub">{dict.featuresSub}</p>
    {dict.features.map((f, i) => <FeatureRow feature={f} image={images[i]} image2={images2[i]} reversed={i % 2 === 1} />)}
  </div></section>
  <MarketSection locale={locale} />
  <InstallSteps locale={locale} />
  <Faq locale={locale} />
  <FinalCta locale={locale} />
</BaseLayout>
