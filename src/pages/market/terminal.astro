---
import BaseLayout from '../../components/BaseLayout.astro';
import MarketTerminal from '../../components/MarketTerminal.astro';
const locale = 'en' as const;
---
<BaseLayout
  locale={locale}
  path="/market/terminal"
  title="TBH Terminal — live TaskBarHero market charts"
  description="Futu-style multi-chart terminal for TaskBarHero items: candlestick + MA/BOLL, volume, order book depth, and a live watchlist.">
  <MarketTerminal locale={locale} />
</BaseLayout>
